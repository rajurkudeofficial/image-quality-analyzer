# Copy this file to .env and adjust as needed.
# All values shown are the defaults used if a variable is not set.

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enhancement backend: "auto" (recommended), "realesrgan", or "classical".
# "auto" uses Real-ESRGAN if the libraries + weights are available,
# otherwise silently falls back to the classical OpenCV pipeline.
ENHANCEMENT_BACKEND=auto

# Optional: HuggingFace Inference API token, only used if you wire up
# the HF fallback path in app/services/enhancer.py for hosted inference
# instead of local Real-ESRGAN.
HF_API_TOKEN=
HF_ENHANCEMENT_MODEL=caidas/swin2SR-classical-sr-x4-64
